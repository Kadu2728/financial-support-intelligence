# Copie para .env e ajuste. .env nunca vai para o repositorio.
# Cada fase adiciona apenas as variaveis que usa.

# --- Aplicacao (Fase 1) ---
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000

# --- Banco (Fase 2) ---
# Neon: use a connection string POOLED (host com -pooler). A variante direta nao
# absorve o cold start do scale-to-zero e estoura o limite de conexoes.
# O prefixo postgresql:// e convertido para postgresql+asyncpg:// automaticamente.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fsi
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Autenticacao (Fase 3) ---
# Minimo de 32 bytes (RFC 7518). Em producao o app recusa subir com o valor de dev.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-secret-local-apenas-trocar-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Storage (Fase 4) ---
# `local` grava em disco e serve so para desenvolvimento: o filesystem do Railway
# e efemero e todo redeploy apagaria o acervo (ADR-0007).
STORAGE_BACKEND=local

# Em producao: STORAGE_BACKEND=s3 e instalar o extra com `pip install -e '.[s3]'`.
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_BUCKET=fsi-documents
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Gemini (Fases 5 e 7) ---
# Sem a chave a API sobe, mas o worker de ingestao e o copilot ficam desativados.
# Crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# --- Worker de ingestao (Fase 5) ---
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=3

# --- Busca e RAG (Fases 6 e 7) — calibrados em docs/rag-design.md ---
SEARCH_CANDIDATES_PER_LEG=30
SEARCH_TOP_K=8
RAG_MIN_TOP_SCORE=0.55
RAG_MIN_SUPPORT_SCORE=0.45
RAG_MIN_SUPPORT_COUNT=2
RAG_CONTEXT_TOKEN_BUDGET=6000

# --- Rate limiting (Fase 10) ---
RATE_LIMIT_COPILOT_PER_MINUTE=20
